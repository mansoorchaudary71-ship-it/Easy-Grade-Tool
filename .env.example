# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production canonical domain and official contact email (optional overrides)
VITE_SITE_URL="https://easygradecalculator.com"
VITE_CONTACT_EMAIL="support@easygradecalculator.com"
CONTACT_EMAIL="support@easygradecalculator.com"

# Optional external persistence/notification relays for user feedback & bug reports
FEEDBACK_WEBHOOK_URL=""
RESEND_API_KEY=""
FEEDBACK_DESTINATION_EMAIL="support@easygradecalculator.com"
