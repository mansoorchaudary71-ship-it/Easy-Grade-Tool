{
  "name": "easy-grade-tool",
  "description": "Calculate grades, weighted averages, GPA, needed final exam scores, tips, percentages, loans, and more.",
  "homepage": "https://www.easygradetool.com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dotfiles",
    "build": "tsx scripts/verify-academic-math.ts && tsx scripts/verify-scale-pages.ts && vite build && tsx scripts/prerender.ts && tsx scripts/generateSitemap.ts && tsx scripts/write-build-info.ts",
    "postbuild": "tsx scripts/verify-launch.ts",
    "verify": "tsx scripts/verify-launch.ts",
    "check:live": "tsx scripts/check-live.ts",
    "verify:selftest": "tsx scripts/verify-selftest.ts",
    "prerender": "tsx scripts/prerender.ts",
    "sitemap": "tsx scripts/generateSitemap.ts",
    "preview": "vite preview",
    "clean": "node -e \"for (const f of ['dist','server.js']) require('fs').rmSync(f,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "verify:math": "tsx scripts/verify-academic-math.ts && tsx scripts/verify-scale-pages.ts"
  },
  "dependencies": {
    "@google/genai": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "compression": "1.8.2",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jspdf": "4.2.1",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-helmet-async": "3.0.0",
    "react-is": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tsx": "4.21.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.28.0",
    "gh-pages": "6.1.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
