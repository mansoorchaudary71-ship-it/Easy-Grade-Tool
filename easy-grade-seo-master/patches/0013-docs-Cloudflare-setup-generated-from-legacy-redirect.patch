+/**
+ * Generates docs/CLOUDFLARE-SETUP.md from the single legacy redirect table, so the Cloudflare rules
+ * can never drift from the table the site itself uses.  Run: npx tsx scripts/generateCloudflareRules.ts
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { LEGACY_REDIRECTS } from '../src/data/legacyRedirects';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const HOST = 'www.easygradetool.com';
+
+const byTarget = new Map<string, string[]>();
+for (const [from, to] of Object.entries(LEGACY_REDIRECTS)) {
+  const list = byTarget.get(to) ?? [];
+  list.push(from);
+  byTarget.set(to, list);
+}
+
+const rules = [...byTarget.entries()]
+  .map(([to, froms], i) => {
+    const paths = froms.flatMap((f) => [`"${f}"`, `"${f}/"`]).join(' ');
+    return [
+      `### Rule ${i + 1} → \`${to}\``,
+      '',
+      'Expression (Edit expression):',
+      '```',
+      `(http.host eq "${HOST}" and http.request.uri.path in {${paths}})`,
+      '```',
+      `Then: **Static** redirect to \`https://${HOST}${to}\`, status **301**, preserve query string **on**.`,
+      '',
+    ].join('\n');
+  })
+  .join('\n');
+
+const doc = `# Cloudflare setup (generated, do not edit by hand)
+
+Generated by \`scripts/generateCloudflareRules.ts\` from \`src/data/legacyRedirects.ts\`.
+Goal: real HTTP 301 redirects and security/cache headers in front of GitHub Pages (audit items T-01, T-02).
+
+## 0. Put the site behind Cloudflare
+1. Add \`easygradetool.com\` to a free Cloudflare account and change the nameservers at your registrar.
+2. DNS: keep the records GitHub Pages needs (CNAME \`www\` → \`<your-user>.github.io\`, plus the four GitHub apex A records if you use the apex). Set the \`www\` record to **Proxied** (orange cloud).
+3. SSL/TLS mode: **Full** (GitHub Pages serves a valid certificate). Turn on **Always Use HTTPS**.
+4. Keep the existing \`CNAME\` file in the repo.
+
+## 1. Redirect Rules (Rules → Redirect Rules → Create rule)
+${byTarget.size} rules, grouped by target. If your Cloudflare plan allows fewer redirect rules than this, use Bulk Redirects (one list entry per legacy URL) instead; check the current limit in the dashboard.
+The 32 stub pages stay in the build as a fallback; once these rules are live, crawlers get a true 301 first.
+
+${rules}
+Optional: redirect the apex to www (Rules → Redirect Rules → \`(http.host eq "easygradetool.com")\` → dynamic \`concat("https://${HOST}", http.request.uri.path)\`, 301).
+
+## 2. Response header rules (Rules → Transform Rules → Modify Response Header)
+Mirrors \`public/_headers\` (GitHub Pages ignores that file). One rule, all requests to ${HOST}:
+| Operation | Header | Value |
+|---|---|---|
+| Set static | X-Content-Type-Options | nosniff |
+| Set static | X-Frame-Options | SAMEORIGIN |
+| Set static | Referrer-Policy | strict-origin-when-cross-origin |
+| Set static | Permissions-Policy | camera=(), microphone=(), geolocation=(), payment=() |
+| Set static | Strict-Transport-Security | max-age=31536000; includeSubDomains |
+
+Enable HSTS only after HTTPS works on every page (it is hard to undo; also available under SSL/TLS → Edge Certificates).
+
+## 3. Cache Rules (Caching → Cache Rules)
+- \`starts_with(http.request.uri.path, "/assets/") or starts_with(http.request.uri.path, "/fonts/")\` → Eligible for cache, Edge TTL 1 year, Browser TTL 1 year (files are hash-named / immutable).
+- \`starts_with(http.request.uri.path, "/images/")\` → Browser TTL 30 days.
+- Do **not** long-cache HTML, \`/sw.js\`, \`/manifest.json\`, \`/sitemap.xml\`.
+
+## 4. Check it worked
+\`\`\`
+curl -sI https://${HOST}/curve-calculator | head -5      # expect 301 and Location: /grade-curve-calculator/
+curl -sI https://${HOST}/ | grep -iE "strict-transport|x-content-type|referrer-policy"
+curl -sI https://${HOST}/assets/<any hashed file> | grep -i cache-control
+\`\`\`
+
+## 5. Search Console (not confirmed which method is in use)
+Prefer **Domain property + DNS TXT record** (works behind Cloudflare, needs no code change, survives redesigns). Only if you must use an HTML tag, send the tag and it will be added to the build.
+`;
+
+const out = path.resolve(__dirname, '../docs/CLOUDFLARE-SETUP.md');
+fs.writeFileSync(out, doc, 'utf8');
+console.log(`wrote ${out} (${byTarget.size} redirect rules)`);
