-  --qg-bg:var(--background,#fff); --qg-fg:var(--foreground,#14213d); --qg-muted:#5b6475;
-  --qg-accent:var(--primary,#0b5fff); --qg-accent-fg:#fff; --qg-line:#d9dee7; --qg-zebra:#f5f7fb;
-  --qg-a:#0f7b3f; --qg-b:#1d5fb8; --qg-c:#8a6100; --qg-d:#b3430f; --qg-f:#b3261e;
-  max-width:880px; margin:0 auto; padding:clamp(16px,4vw,32px); color:var(--qg-fg);
-}
-@media (prefers-color-scheme:dark){
-  :root:not([data-theme="light"]) .qg{--qg-bg:#0f1420;--qg-fg:#e8ecf4;--qg-muted:#9aa4b8;--qg-line:#2a3350;--qg-zebra:#161d2e;
-    --qg-a:#4cd08a;--qg-b:#7db2ff;--qg-c:#f0c14d;--qg-d:#ff9a62;--qg-f:#ff7a72}
-}
-.qg h1{font-size:clamp(1.5rem,4.5vw,2.2rem);line-height:1.15;margin:0 0 .4rem}
-.qg-sub{margin:0 0 1.25rem;color:var(--qg-muted);max-width:60ch}
-.qg-controls{display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-end}
-.qg-field{display:flex;flex-direction:column;gap:.35rem;font-size:.95rem;border:0;padding:0;margin:0}
-.qg-field input,.qg-field select{font:inherit;padding:.65rem .8rem;border:1.5px solid var(--qg-line);border-radius:8px;background:var(--qg-bg);color:var(--qg-fg);min-height:44px}
-#qg-total{width:11rem;font-size:1.4rem;font-weight:650}
-.qg-print{font:inherit;font-weight:650;font-size:1.05rem;padding:.8rem 1.6rem;min-height:48px;border:0;border-radius:10px;background:var(--qg-accent);color:var(--qg-accent-fg);cursor:pointer}
-.qg-print:hover{filter:brightness(1.08)}
-.qg :focus-visible{outline:3px solid var(--qg-accent);outline-offset:2px}
-.qg-error{color:var(--qg-f);margin:.75rem 0 0;font-weight:600}
-.qg-adv{margin:1.1rem 0;border:1px solid var(--qg-line);border-radius:10px;padding:.2rem 1rem}
-.qg-adv summary{cursor:pointer;padding:.7rem 0;font-weight:600}
-.qg-adv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;padding:.4rem 0 1rem}
-.qg-scale{grid-column:1/-1}
-.qg-scale-row{display:flex;gap:1rem;flex-wrap:wrap}
-.qg-scale-row label{display:flex;align-items:center;gap:.4rem}
-.qg-scale-row input{width:5rem}
-.qg-check{display:flex;align-items:center;gap:.5rem}
-.qg-link{background:none;border:0;color:var(--qg-accent);text-decoration:underline;cursor:pointer;font:inherit;justify-self:start;padding:.5rem 0;min-height:44px}
-.qg-print-title{display:none}
-.qg-table-wrap{overflow-x:auto;border:1px solid var(--qg-line);border-radius:10px;max-height:70vh}
-.qg-table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums;text-align:center}
-.qg-table th,.qg-table td{padding:.55rem .8rem;border-bottom:1px solid var(--qg-line)}
-.qg-table thead th{position:sticky;top:0;background:var(--qg-bg);border-bottom:2px solid var(--qg-fg);z-index:1}
-.qg-table tbody tr:nth-child(even){background:var(--qg-zebra)}
-.qg-table .g-A{color:var(--qg-a);font-weight:700}
-.qg-table .g-B{color:var(--qg-b);font-weight:700}
-.qg-table .g-C{color:var(--qg-c);font-weight:700}
-.qg-table .g-D{color:var(--qg-d);font-weight:700}
-.qg-table .g-F{color:var(--qg-f);font-weight:700}
-.qg-foot{color:var(--qg-muted);font-size:.9rem;margin-top:1rem}
-.qg-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
-@media (prefers-reduced-motion:reduce){.qg *{transition:none!important;animation:none!important}}
